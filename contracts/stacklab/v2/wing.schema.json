{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirsi.local/contracts/stacklab/v2/wing.schema.json",
  "title": "Sirsi Stack Lab wing v1",
  "description": "One project-scoped work wing. The Router uses these records to expose provenance without granting cross-project filesystem authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "owner", "project_id", "router_namespace", "class", "scope", "status", "first_gate", "workspace", "handoffs", "provenance", "mirrors", "next_action"],
  "properties": {
    "schema": {"const": "sirsi.stacklab.wing.v1"},
    "id": {"pattern": "^stacklab\\.wing\\.[a-z0-9][a-z0-9.-]*$"},
    "owner": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "router_namespace": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "class": {"enum": ["engine", "control-plane", "operator-surface", "transport", "hardware", "application"]},
    "scope": {"type": "string", "minLength": 1},
    "status": {"enum": ["intake", "active", "held", "retired"]},
    "first_gate": {"type": "string", "minLength": 1},
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_root", "writable_roots", "evidence_root", "shared_payload_access", "boundary_policy"],
      "properties": {
        "repository_root": {"type": "string", "minLength": 2},
        "writable_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 2}},
        "evidence_root": {"type": "string", "minLength": 2},
        "shared_payload_access": {"enum": ["none", "read-only-by-identity"]},
        "boundary_policy": {"const": "default-deny"}
      }
    },
    "handoffs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inbound", "outbound", "allowed_peer_wings"],
      "properties": {
        "inbound": {"const": "router-receipt-only"},
        "outbound": {"const": "router-receipt-only"},
        "allowed_peer_wings": {"type": "array", "items": {"type": "string", "pattern": "^stacklab\\.wing\\."}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lifecycle_task_id", "component_catalog", "receipt_links"],
      "properties": {
        "lifecycle_task_id": {"type": "string", "minLength": 1},
        "component_catalog": {"type": "string", "minLength": 1},
        "receipt_links": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "mirrors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "desktop", "workspace"],
      "properties": {
        "repository": {"enum": ["current", "pending", "stale", "blocked"]},
        "desktop": {"enum": ["current", "pending", "stale", "blocked"]},
        "workspace": {"enum": ["current", "pending", "stale", "blocked"]}
      }
    },
    "next_action": {"type": "string", "minLength": 1}
  },
  "$comment": "Schema validation establishes field shape. Router enforcement must additionally prove every writable root is inside the declared repository or the declared project/namespace evidence root, and must reject all other paths."
}
