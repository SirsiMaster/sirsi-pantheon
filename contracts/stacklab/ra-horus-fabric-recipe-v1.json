{
  "schema": "sirsi.stacklab.recipe.v1",
  "id": "stacklab.recipe.ra-horus-fabric",
  "wing": "stacklab.wing.ra-horus-fabric",
  "product": "sirsi-pantheon",
  "version": 1,
  "purpose": "Executable source, test, security, design, and operational inventory for the single Ra/Horus router fabric.",
  "authority": {
    "decision_writer": "sirsi router service",
    "assessment_owner": "Ma'at",
    "projection_owner": "Horus FabricBoard",
    "cross_device_transport": "authenticated router receipt",
    "prohibited": [
      "no second router store",
      "no caller-selected Ra sender identity",
      "no projection-derived authorization",
      "no fabricated zero or success when the producer is unavailable"
    ]
  },
  "components": [
    {
      "id": "fabric-board",
      "source": ["internal/ra", "internal/routerstore", "internal/ledger"],
      "tests": ["internal/ra", "internal/routerstore", "internal/ledger"],
      "inputs": ["router receipts", "ledger tasks", "lane state"],
      "outputs": ["FabricBoard"],
      "writes": [],
      "upgrade_recipe": ["preserve stream-separated counts", "add fixture before changing classification", "run focused and race tests"]
    },
    {
      "id": "native-handoff",
      "source": ["macapp/Sources/SirsiMenubar/SirsiEngine.swift", "macapp/Sources/SirsiMenubar/Views.swift"],
      "tests": ["macapp tests", "macapp/check-cli-flags.sh"],
      "inputs": ["typed destination and payload"],
      "outputs": ["authenticated handoff"],
      "writes": ["canonical router service"],
      "upgrade_recipe": ["retain fixed Horus sender", "rebuild before release", "prove runtime identity"]
    },
    {
      "id": "router-service",
      "source": ["internal/router", "internal/routerstore", "cmd/sirsi/routercmd.go"],
      "tests": ["internal/router tests", "router rollback fixtures"],
      "inputs": ["host-bound token", "session", "lease"],
      "outputs": ["leases", "wake events", "receipts"],
      "writes": ["canonical service backend"],
      "upgrade_recipe": ["preserve TTL and revocation fencing", "rehearse outage and rollback", "never reopen local fallback"]
    },
    {
      "id": "stacklab-contract",
      "source": ["contracts/stacklab/ra-horus-fabric-wing-v1.json", "docs/stacklab/RA_HORUS_FABRIC_COMPONENT_CATALOG.md", "docs/stacklab/RA_HORUS_FABRIC_TRACEABILITY_MATRIX.md"],
      "tests": ["sirsi stacklab doctor", "schema validation"],
      "inputs": ["committed source and durable receipts"],
      "outputs": ["registry provenance"],
      "writes": ["contract files only"],
      "upgrade_recipe": ["validate locally", "review exact bytes", "pin on origin/main"]
    }
  ]
}
