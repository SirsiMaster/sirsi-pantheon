# Binaries (root-level only — don't match cmd/ subdirs)
/anubis
/anubis-agent
*.exe
*.dll
*.so
*.dylib

# Build output
dist/
build/

# Test output
coverage.out
*.test

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Config (user-specific)
*.local.yaml

# Temporary
tmp/
.tmp/
/pantheon
/pantheon-agent
/pantheon-menubar
/thoth
/language_server_macos_arm

bin/
coverage_target_modules.out
Pantheon.app/

# iOS (regenerated via xcodegen + gomobile)
ios/build/
ios/Pantheon.xcodeproj/
ios/Package.swift

# Ma'at Pulse — dynamic measurement output (local only)
.pantheon/
*.out
.firebase/
ios/.build/

/sirsi
/sirsi-agent
/sirsi-menubar

# Extension package artifacts and embedded CLI copies are generated, not source.
extensions/**/*.vsix
extensions/*/sirsi

# Idea Router runtime artifacts
.agents/idea-router/bin/
.agents/idea-router/work-queue.json
.agents/idea-router/threads.json
.agents/idea-router/logs/
.agents/idea-router/.threads.json-*
.agents/idea-router/processes.json
.agents/idea-router/locks/
# Router messages are EPHEMERAL per-machine runtime state (like the queue/registry
# above), not source. Tracking them churned the worktree (hundreds of modified
# .md every session) and is the "dirty status" operator clutter. Ignore + untrack.
.agents/idea-router/items/

# Claude local runtime artifacts
.claude/hooks/__pycache__/

# Claude Code agent worktrees (isolated, never tracked)
.claude/worktrees/

# Idea-router review artifacts — ephemeral runtime output, local-only
.agents/idea-router/reviews/
