#!/bin/bash
# 𓆄 Ma'at Pre-Push Gate (Pantheon)
# Guarantees CI stays green by running checks before push.
# Install: git config core.hooksPath .githooks
# Skip:    git push --no-verify (use sparingly)
#
# DEPTH TIERS (set MAAT_DEPTH env var, default: fast):
#   fast     — fmt + vet + build + diff-only tests          (~10-30s)
#   standard — fast + Ma'at coverage + canon on changed     (~60-90s)
#   deep     — standard + full test suite + full Ma'at      (~3-5 min)
#
# Examples:
#   git push                           # uses fast (default)
#   MAAT_DEPTH=standard git push       # adds Ma'at on changed pkgs
#   MAAT_DEPTH=deep git push           # full suite (pre-release)

set -e

DEPTH="${MAAT_DEPTH:-fast}"

# ── Ma'at measurement window ─────────────────────────────────────────
# A push starts CI on the local self-hosted runners and a tag starts the release
# build; either contaminates a measurement run while rails.lock exists
# (2026-09-30: PR #928 CI began 6s after mercury opened the lock).
# MAAT_WINDOW_OVERRIDE=1 is the owner's deliberate bypass.
RAILS_LOCK="${MAAT_RAILS_LOCK:-$HOME/libsirsimpi/rails.lock}"
if [ -e "$RAILS_LOCK" ] && [ -z "${MAAT_WINDOW_OVERRIDE:-}" ]; then
    echo ""
    echo "  𓆄 Ma'at pre-push gate: a measurement window is open ($(head -c 60 "$RAILS_LOCK" | tr -d '\n'))."
    echo "  Pushing now would start CI mid-run. Wait for $RAILS_LOCK to clear, or MAAT_WINDOW_OVERRIDE=1."
    echo ""
    exit 1
fi

# ── Detect no-content pushes + capture push refs ─────────────────────
# Git pre-push hook receives: <local-ref> <local-sha> <remote-ref> <remote-sha>
# on stdin. remote_sha is what the remote has NOW — the correct base
# for our diff. If remote_sha is all zeros, this is a new branch; if
# local_sha is all zeros, this ref is being DELETED (git push --delete).
# A push carrying only tag refs and/or ref-deletions changes zero code, so
# it skips the full fmt/vet/lint/build pipeline (bulk branch hygiene via
# `git push --delete` otherwise ran the whole gate per deleted branch).
ZERO_SHA="0000000000000000000000000000000000000000"
NO_CONTENT_PUSH=true
PUSH_LOCAL_SHA=""
PUSH_REMOTE_SHA=""
PUSH_REFS=""        # every content-bearing ref as "<ref>:<local_sha>:<remote_sha>" (ADR-076: all refs are gated, not the last one read)
while read local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/tags/*) ;;                    # tag push — no code content
        *)
            if [ "$local_sha" = "$ZERO_SHA" ]; then
                : # branch/ref deletion — no code content, nothing to check
            else
                NO_CONTENT_PUSH=false
                PUSH_LOCAL_SHA="$local_sha"
                PUSH_REMOTE_SHA="$remote_sha"
                PUSH_REFS="${PUSH_REFS:+$PUSH_REFS }${local_ref}:${local_sha}:${remote_sha}"
            fi
            ;;
    esac
done

if [ "$NO_CONTENT_PUSH" = "true" ]; then
    echo ""
    echo "  𓆄 Ma'at pre-push gate... [Pantheon | depth: fast]"
    echo ""
    echo "  ⏭️  Tag / ref-deletion only — nothing to check, fast pass"
    exit 0
fi

# ── Queue behind any other gate running on this host ─────────────────
# shellcheck source=gate-lock.sh
. "$(cd "$(dirname "$0")" && pwd)/gate-lock.sh"
gate_lock_acquire || exit 1
# shellcheck source=gate-advise.sh
. "$(cd "$(dirname "$0")" && pwd)/gate-advise.sh"
trap 'gate_lock_release; rm -rf "$GATE_OUT"' EXIT

# ── Detect changed files (for diff-based testing + auto-escalation) ──
CHANGED_PKGS=""

if [ -n "$PUSH_REMOTE_SHA" ] && [ "$PUSH_REMOTE_SHA" != "$ZERO_SHA" ]; then
    DIFF_BASE="$PUSH_REMOTE_SHA"
elif [ -n "$PUSH_REMOTE_SHA" ] && [ "$PUSH_REMOTE_SHA" = "$ZERO_SHA" ]; then
    # New branch (remote_sha=zeros): fall back to the merge-base with the
    # default integration branch so we test ONLY the packages this branch
    # actually changes — not every package that ever differed since the
    # branch root. Previously DIFF_BASE was left empty here, which triggered
    # the "all packages" path below and over-scoped lint/test to unrelated
    # subsystems (e.g. an edit in cmd/sirsi tripped flakes in jackal/rules).
    DIFF_BASE=$(git merge-base HEAD origin/main 2>/dev/null || \
                git merge-base HEAD origin/master 2>/dev/null || echo "")
else
    DIFF_BASE=$(git rev-parse --verify @{push} 2>/dev/null || \
                git rev-parse --verify HEAD~1 2>/dev/null || echo "")
fi

if [ -z "$DIFF_BASE" ]; then
    CHANGED_GO_FILES="all"
    ALL_CHANGED_FILES="all"
elif [ -n "$PUSH_LOCAL_SHA" ]; then
    CHANGED_GO_FILES=$(git diff --name-only "$DIFF_BASE" "$PUSH_LOCAL_SHA" -- '*.go' 2>/dev/null || echo "")
    ALL_CHANGED_FILES=$(git diff --name-only "$DIFF_BASE" "$PUSH_LOCAL_SHA" 2>/dev/null || echo "")
else
    CHANGED_GO_FILES=$(git diff --name-only "$DIFF_BASE" HEAD -- '*.go' 2>/dev/null || echo "")
    ALL_CHANGED_FILES=$(git diff --name-only "$DIFF_BASE" HEAD 2>/dev/null || echo "")
fi

if [ "$CHANGED_GO_FILES" = "all" ]; then
    CHANGED_PKGS="./..."
elif [ -n "$CHANGED_GO_FILES" ]; then
    # testdata/ holds fixtures the go tool never compiles; CI's `./...` skips them, so must we.
    CHANGED_PKGS=$(echo "$CHANGED_GO_FILES" | grep -v '/testdata/' | xargs -I{} dirname {} | sort -u | \
                   while read dir; do [ -d "$dir" ] && echo "./$dir"; done | tr '\n' ' ')
fi

# ── Auto-escalation: detect when fast mode isn't enough ──────────────
# Only escalate if user didn't explicitly set MAAT_DEPTH.
ESCALATION_REASON=""
if [ -z "$MAAT_DEPTH" ]; then

    # 1. VERSION file changed → release in progress → deep
    if echo "$ALL_CHANGED_FILES" | grep -q "^VERSION$" 2>/dev/null; then
        DEPTH="deep"
        ESCALATION_REASON="VERSION changed (release detected)"
    fi

    # 2. Safety-critical files → standard
    if echo "$ALL_CHANGED_FILES" | grep -qE "(internal/cleaner/safety|internal/guard/|internal/platform/|\.githooks/)" 2>/dev/null; then
        [ "$DEPTH" = "fast" ] && DEPTH="standard"
        ESCALATION_REASON="safety-critical files modified"
    fi

    # 3. MCP/public API surface → standard
    if echo "$ALL_CHANGED_FILES" | grep -qE "(internal/mcp/server\.go|internal/mcp/tools\.go)" 2>/dev/null; then
        [ "$DEPTH" = "fast" ] && DEPTH="standard"
        ESCALATION_REASON="MCP API surface changed"
    fi

    # 4. New packages detected → standard
    if [ "$CHANGED_GO_FILES" != "all" ] && [ -n "$CHANGED_GO_FILES" ]; then
        NEW_DIRS=$(echo "$CHANGED_GO_FILES" | xargs -I{} dirname {} | sort -u | \
                   while read dir; do
                       # Check if this directory existed on the remote
                       if [ -n "$DIFF_BASE" ] && ! git ls-tree -d "$DIFF_BASE" -- "$dir" >/dev/null 2>&1; then
                           echo "$dir"
                       fi
                   done)
        if [ -n "$NEW_DIRS" ]; then
            [ "$DEPTH" = "fast" ] && DEPTH="standard"
            ESCALATION_REASON="new package(s): $(echo $NEW_DIRS | tr '\n' ' ')"
        fi
    fi

    # 5. Large changeset (>15 Go files) → standard
    if [ "$CHANGED_GO_FILES" != "all" ] && [ -n "$CHANGED_GO_FILES" ]; then
        FILE_COUNT=$(echo "$CHANGED_GO_FILES" | wc -l | tr -d ' ')
        if [ "$FILE_COUNT" -gt 15 ]; then
            [ "$DEPTH" = "fast" ] && DEPTH="standard"
            ESCALATION_REASON="large changeset ($FILE_COUNT Go files)"
        fi
    fi

    # 6. Previous CI failed → standard
    if command -v gh >/dev/null 2>&1; then
        LAST_CI=$(gh run list --limit 1 --json conclusion -q '.[0].conclusion' 2>/dev/null || echo "")
        if [ "$LAST_CI" = "failure" ]; then
            [ "$DEPTH" = "fast" ] && DEPTH="standard"
            ESCALATION_REASON="previous CI run failed"
        fi
    fi
fi

echo ""
if [ -n "$ESCALATION_REASON" ]; then
    echo "  𓆄 Ma'at pre-push gate... [Pantheon | depth: $DEPTH ← auto-escalated]"
    echo "  ↑ Reason: $ESCALATION_REASON"
else
    echo "  𓆄 Ma'at pre-push gate... [Pantheon | depth: $DEPTH]"
fi
echo ""

# ── 0. gitleaks — committed-secret scan (PANTHEON_RULES.md A28, SECURITY.md) ──
# Scans only the commits being pushed (fast; no full-history rescan) using git's
# pre-push contract. New branch (remote_sha=zeros) → scan from the merge-base with
# origin/main so we don't rescan all of history. CI runs the same scan and is the
# authoritative gate, so a missing gitleaks binary here only warns — never blocks.
if command -v gitleaks >/dev/null 2>&1; then
    echo "  🔑 gitleaks — scanning pushed commits for secrets..."
    if [ -n "$PUSH_LOCAL_SHA" ] && [ "$PUSH_LOCAL_SHA" != "$ZERO_SHA" ]; then
        if [ -n "$PUSH_REMOTE_SHA" ] && [ "$PUSH_REMOTE_SHA" != "$ZERO_SHA" ]; then
            GL_RANGE="${PUSH_REMOTE_SHA}..${PUSH_LOCAL_SHA}"
        else
            GL_BASE=$(git merge-base HEAD origin/main 2>/dev/null || \
                      git merge-base HEAD origin/master 2>/dev/null || echo "")
            GL_RANGE="${GL_BASE:+$GL_BASE..}${PUSH_LOCAL_SHA}"
        fi
        if ! gitleaks detect --log-opts="$GL_RANGE" --no-banner --redact 2>/dev/null; then
            echo "  ❌ gitleaks found a committed secret in $GL_RANGE — fix before pushing."
            echo "     Do NOT --no-verify past this. If it's a false positive, add a"
            echo "     precise, documented entry to .gitleaks.toml (never blanket-allowlist)."
            exit 1
        fi
    fi
else
    echo "  ⚠️  gitleaks not installed — secret scan SKIPPED (install: brew install gitleaks). CI still gates this."
fi

# ── 1. gofmt — formatting must be canonical ─────────────────────────
BAD_FMT=$(gofmt -l ./internal/ ./cmd/ 2>/dev/null || true)
if [ -n "$BAD_FMT" ]; then
    echo "  ❌ gofmt — these files need formatting:"
    echo "$BAD_FMT" | sed 's/^/     /'
    echo ""
    echo "  Fix: gofmt -w ./internal/ ./cmd/"
    printf '%s\n' "$BAD_FMT" > "$GATE_OUT/gofmt.log"
    gate_advise gofmt "$GATE_OUT/gofmt.log"
    exit 1
fi

# ── 2. go vet — static analysis ─────────────────────────────────────
if ! gate_run vet go vet ./...; then
    echo "  ❌ go vet failed"
    exit 1
fi

# ── 2b. router store direct-open gate (ADR-062 §1) — matches CI exactly ──
if [ -x scripts/check-router-store-open.sh ]; then
    if ! gate_run direct-open bash scripts/check-router-store-open.sh; then
        echo "  ❌ router store opened outside routerstore.Resolve() — run: bash scripts/check-router-store-open.sh"
        exit 1
    fi
fi

# ── 2c. changelog straggler guard — CHANGELOG.md is assembled, not hand-edited ──
if [ -x scripts/check-changelog-straggler.sh ]; then
    CL_BASE="${DIFF_BASE:-}"
    if [ -n "$PUSH_LOCAL_SHA" ] && [ "$PUSH_LOCAL_SHA" != "$ZERO_SHA" ]; then
        CL_HEAD="$PUSH_LOCAL_SHA"
    else
        CL_HEAD="HEAD"
    fi
    CL_BRANCH="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
    if ! bash scripts/check-changelog-straggler.sh ${CL_BASE:+--base="$CL_BASE"} --head="$CL_HEAD" --branch="$CL_BRANCH"; then
        exit 1
    fi
fi

# ── 3. golangci-lint — matches CI exactly ───────────────────────────
if command -v golangci-lint >/dev/null 2>&1; then
    if [ -n "$CHANGED_PKGS" ] && [ "$CHANGED_PKGS" != "./..." ]; then
        # Lint only changed packages for speed
        if ! gate_run lint golangci-lint run $CHANGED_PKGS; then
            echo "  ❌ golangci-lint failed on changed packages"
            echo "  Fix: golangci-lint run --fix $CHANGED_PKGS"
            exit 1
        fi
    else
        if ! gate_run lint golangci-lint run ./...; then
            echo "  ❌ golangci-lint failed"
            echo "  Fix: golangci-lint run --fix ./..."
            exit 1
        fi
    fi
else
    echo "  ⚠️  golangci-lint not installed — skipping (CI will catch issues)"
fi

# ── 4. Build check — both binaries ──────────────────────────────────
if ! gate_run build go build ./...; then
    echo "  ❌ build failed"
    exit 1
fi

# ── 4b. Trust-Boundary gate (ADR-076, Universal Rule 32) — A–H lint on EVERY pushed ref ──
# Each finding names its rule letter; a reviewed false positive is silenced with
# `trust-boundary: <reason>` on the line or the line above. The exit status gates.
# The lint reads the blobs at each pushed head, never this working tree. A new
# branch whose base cannot be resolved is refused (fail closed), not skipped.
TB_FAILED=0
for entry in $PUSH_REFS; do
    tb_ref="${entry%%:*}"; rest="${entry#*:}"; tb_head="${rest%%:*}"; tb_remote="${rest#*:}"
    if [ "$tb_remote" != "$ZERO_SHA" ]; then
        tb_base="$tb_remote"
    else
        tb_base=$(git merge-base "$tb_head" origin/main 2>/dev/null || git merge-base "$tb_head" origin/master 2>/dev/null || echo "")
        if [ -z "$tb_base" ]; then
            echo "  ❌ $tb_ref: new branch with no resolvable base (fetch origin) — refusing to push unchecked (ADR-076 H)"
            TB_FAILED=1; continue
        fi
    fi
    if ! go run ./cmd/sirsi maat gate --lint-only --base "$tb_base" --head "$tb_head"; then
        echo "  ❌ Trust-Boundary lint failed for $tb_ref (ADR-076) — fix it or record the reason on the line"
        TB_FAILED=1
    fi
done
[ "$TB_FAILED" = 0 ] || exit 1

# ── 5. Tests — diff-based or full depending on depth ────────────────
# Tests run against the WORKING TREE, not the sha being pushed. An uncommitted
# file marks the Go VCS stamp DIRTY, which makes routerstore refuse its v0→v1
# test migration — surfacing as ~6 unrelated cmd/sirsi failures that have
# nothing to do with the pushed commit. Name the cause before it costs an hour.
DIRTY_TREE="$(git status --porcelain)"
if [ -n "$DIRTY_TREE" ]; then
    echo "  ⚠️  Working tree is DIRTY — tests below run on THIS tree, not the pushed sha."
    echo "     A dirty tree stamps the build DIRTY; routerstore then refuses its test"
    echo "     migration and cmd/sirsi tests fail for reasons unrelated to your commit."
    echo "     Commit or stash before reading any failure below as a real regression:"
    echo "$DIRTY_TREE" | sed 's/^/       /'
fi

# CI runs with NO SIRSI_* env; an interactive shell exporting SIRSI_ROUTER_URL /
# SIRSI_RELAY_TRUST_GROUP makes routerstore tests fail for reasons unrelated to the
# diff (blocked a clean push 2026-09-16). Scrub them so the gate matches CI (A28).
SCRUB_SIRSI=$(env | sed -n 's/^\(SIRSI_[A-Za-z0-9_]*\)=.*/-u \1/p' | tr '\n' ' ')

if [ "$DEPTH" = "deep" ]; then
    # Deep: full test suite under CI's exact flags (-race -short; A28 parity)
    echo "  🧪 Running full test suite..."
    if ! gate_run tests env $SCRUB_SIRSI go test -race -short ./... -count=1 -timeout 900s; then
        echo "  ❌ Tests failed — fix before pushing."
        exit 1
    fi
elif [ -n "$CHANGED_PKGS" ]; then
    # Fast/Standard: only test changed packages. 900s (not 300s) to match
    # CI's own untimed (10m default) `go test ./...` — a single growing
    # package (routerstore: 184s under -race on 2026-09-19, 572s on
    # 2026-10-01, 614.6s on 2026-10-02) must not fail a gate CI itself would
    # pass (A28: local gate parity with CI). Re-measure and raise again if
    # routerstore keeps growing.
    echo "  🧪 Testing changed packages: $(echo $CHANGED_PKGS | wc -w | tr -d ' ') pkg(s)"
    if ! gate_run tests env $SCRUB_SIRSI go test -race -short $CHANGED_PKGS -count=1 -timeout 900s; then
        echo "  ❌ Tests failed in changed packages — fix before pushing."
        exit 1
    fi
else
    echo "  🧪 No Go files changed — skipping tests"
fi

# ── 6. Ma'at — only on standard/deep ────────────────────────────────
if [ "$DEPTH" = "standard" ] || [ "$DEPTH" = "deep" ]; then
    go build -o ./sirsi ./cmd/sirsi/ 2>/dev/null
    if [ -x "./sirsi" ]; then
        echo "  𓆄 Ma'at quality assessment..."
        gate_run maat-pulse ./sirsi maat pulse --skip-test || {
            echo "  ❌ Ma'at assessment failed"
            exit 1
        }
        rm -f ./sirsi
    fi
elif [ "$DEPTH" = "fast" ]; then
    echo "  ⏭️  Ma'at skipped (use MAAT_DEPTH=standard for assessment)"
fi

# ── 7. Thoth health ─────────────────────────────────────────────────
if [ -f ".thoth/memory.yaml" ]; then
    if ! grep -q "project: sirsi-pantheon" .thoth/memory.yaml 2>/dev/null; then
        echo "  ⚠️  Thoth memory mismatch (non-blocking)"
    fi
fi

echo "  ✅ Pipeline gate passed — pushing to the Pantheon"
echo ""
